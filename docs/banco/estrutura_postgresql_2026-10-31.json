  "data": "2026-10-31",
  "commit": "54773ab",
  "views": [
    {
      "name": "produto_com_estoque",
      "definition": " SELECT codprod,\n    nome_produto,\n    preco,\n    descricao,\n    categoria,\n    status_disponibilidade,\n    imagem_url,\n    eh_kit,\n        CASE\n            WHEN eh_kit THEN COALESCE(( SELECT min(\n                    CASE\n                        WHEN (c.eh_kit OR ((c.status_disponibilidade)::text <> 'disponivel'::text)) THEN 0\n                        ELSE (c.estoque / k.quantidade)\n                    END) AS min\n               FROM (kit_componente k\n                 JOIN produto c ON ((c.codprod = k.id_produto)))\n              WHERE (k.id_kit = p.codprod)), 0)\n            ELSE estoque\n        END AS estoque\n   FROM produto p;"
    }
  ],
